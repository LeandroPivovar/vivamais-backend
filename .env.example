PORT=3011
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=acesso_saude
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Integração Vencca (cadastro de associados + telemedicina médica).
# Deixe VENCCA_ENABLED=false até ter host, token e id-parceiro reais.
# Docs: https://app.veenca.com/docs
VENCCA_ENABLED=false
VENCCA_CADASTRO_URL=
VENCCA_TELEMED_URL=
VENCCA_TELEMED_API_KEY=
VENCCA_TOKEN=
VENCCA_PARTNER_ID=
VENCCA_SSO_URL=

# URL pública desta API. Usada para montar o callbackUrl que a Veenca chama no webhook
# de pagamento — se apontar para localhost, o webhook nunca chega.
PUBLIC_URL=https://conta.vivamaisclub.com

# Chaves do gateway Veenca NÃO ficam aqui: são configuradas pelo Admin e gravadas
# no banco (app_config).

# SMTP — recuperação de senha e senha inicial do usuário. Sem estas vars o envio
# de e-mail vira no-op (nada quebra, só não envia). Gmail exige "senha de app".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@vivamaisclub.com
SMTP_PASS=
SMTP_FROM=Viva Mais Club <contato@vivamaisclub.com>
